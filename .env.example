NODE_ENV=development
DATABASE_URL=postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=tradepilot-private
S3_ACCESS_KEY=tradepilot
S3_SECRET_KEY=change-this-local-secret
SUPPLIER_SEARCH_PROVIDER_BASE_URL=
SUPPLIER_SEARCH_PROVIDER_URL=
SUPPLIER_SEARCH_PROVIDER_HEALTH_URL=
SUPPLIER_SEARCH_PROVIDER_TOKEN=
SUPPLIER_SEARCH_PROVIDER_TIMEOUT_MS=55000
SUPPLIER_SEARCH_PROVIDER_MAX_ATTEMPTS=1
URL_IMPORT_PROVIDER_URL=
URL_IMPORT_PROVIDER_TOKEN=
BILLING_CHECKOUT_PROVIDER_URL=
BILLING_CHECKOUT_PROVIDER_TOKEN=
BILLING_EVENT_TOKEN=
# Server-only key for supplier-message translation. Do not reuse the supplier-search provider key and do not expose this value to the browser.
SUPPLIER_MESSAGE_OPENAI_API_KEY=
SUPPLIER_MESSAGE_OPENAI_MODEL=gpt-5-mini
SUPPLIER_MESSAGE_OPENAI_TIMEOUT_MS=30000
SUPPLIER_MESSAGE_OPENAI_PRICING_VERSION=openai-standard-2026-08-06
SUPPLIER_MESSAGE_INPUT_PRICE_PER_MILLION_USD=0.25
SUPPLIER_MESSAGE_CACHED_INPUT_PRICE_PER_MILLION_USD=0.025
SUPPLIER_MESSAGE_OUTPUT_PRICE_PER_MILLION_USD=2

# Optional Gmail mailbox connection (separate from Google Sign-In).
# The feature is disabled until explicitly enabled on the acceptance staging
# Render service and its dedicated Google OAuth client is configured.
JAKOV360_GMAIL_STAGING_ENABLED=false
JAKOV360_GMAIL_CLIENT_ID=
JAKOV360_GMAIL_CLIENT_SECRET=
JAKOV360_GMAIL_REDIRECT_URI=
# Server-only AES-256-GCM key: 32 random bytes encoded as base64url.
# Keep this secret out of GitHub, logs and browser responses.
JAKOV360_GMAIL_TOKEN_KEY_V1_B64=

# This does not grant inbox access; M1c only sends reviewed inquiries.

# M1c only: comma-separated email addresses of user-controlled test recipients.
# Empty means Gmail sending is blocked even when OAuth is enabled.
JAKOV360_GMAIL_TEST_RECIPIENTS=
