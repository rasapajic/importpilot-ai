PORT=4000
SEARCH_PROVIDER_TOKEN=change-this-search-provider-token
SEARCH_RATE_LIMIT_MAX=30
SEARCH_RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=90000

# Isti deterministički Idempotency-Key i isti validirani zahtev dele jedan aktivni
# search i zatim kratko vraćaju isti završeni rezultat. Time dvostruki klik,
# paralelni browser zahtev ili bezbedan HTTP retry ne pokreću drugi plaćeni AI tok.
SEARCH_IDEMPOTENCY_TTL_MS=120000

# TAJA Deep Search prikuplja kandidate iz svih konfigurisanih izvora,
# uklanja duplikate i vraća raznovrstan objedinjeni skup za narednu analizu.
TAJA_DEEP_SEARCH_MAX_RESULTS=30
TAJA_DEEP_SEARCH_MAX_PER_SOURCE=15

# Interfejs preliminarno ističe prva tri rangirana kandidata, prikazuje još
# sedam odmah, a korisnik može da otvori sve preostale pronađene ponude.
# Konačni ranking uključuje samo potvrđeni landed cost i proveru rizika.

# Opšta TAJA web pretraga preko OpenAI Responses API-ja.
# API ključ se kreira u OpenAI Platform projektu i nikada se ne šalje u browser.
# Ovaj prolaz traži do 10 proverljivih direktnih stranica dobavljača.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_SEARCH_MAX_RESULTS=10
OPENAI_SEARCH_TIMEOUT_MS=45000
OPENAI_SEARCH_CONTEXT_SIZE=low

# Kada direktni Alibaba adapter ne vrati nijednu upotrebljivu karticu, pokreće
# se jedan strogo ograničen web-search fallback koji prihvata samo citirane
# HTTPS Alibaba product-detail stranice.
OPENAI_ALIBABA_MAX_RESULTS=5

# Poseban TAJA 1688 prolaz koristi kineske sourcing upite i poseban 1688-only
# prompt. Upiti ciljaju indeksirane detail/m offer hostove i prihvataju samo
# citirane HTTPS offer stranice oblika *.1688.com/offer/<broj>.htm[l]. Odbijeni
# host/path i razlog se beleže u development logu. Jedan dodatni batch poziv
# dopunjava najviše pet najboljih nepotpunih 1688 ponuda.
OPENAI_1688_MAX_RESULTS=10
OPENAI_1688_ENRICH_MAX_RESULTS=5
OPENAI_1688_ENRICH_TIMEOUT_MS=30000

# Cenovni snapshot se upisuje uz svaki AI događaj. Kada se cenovnik promeni,
# menjaju se ove vrednosti, dok istorijski događaji zadržavaju stare cene.
OPENAI_PRICING_VERSION=openai-standard-2026-08-06
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.25
OPENAI_CACHED_INPUT_PRICE_PER_MILLION_USD=0.025
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=2.00
OPENAI_WEB_SEARCH_PRICE_PER_CALL_USD=0.01

# Direktni marketplace izvori rade paralelno sa OpenAI prolazima. Svaki adapter
# izvršava ograničen skup requirement-driven upita i rezultat ulazi u isti
# deduplikovani skup kandidata.
ALIBABA_QUERY_VARIANT_LIMIT=5
MADE_IN_CHINA_QUERY_VARIANT_LIMIT=5
ALIBABA_TIMEOUT_MS=4000
MADE_IN_CHINA_TIMEOUT_MS=5000
ALIBABA_USER_AGENT=Mozilla/5.0 (compatible; ImportPilotSearchProvider/1.0)
MADE_IN_CHINA_USER_AGENT=Mozilla/5.0 (compatible; ImportPilotSearchProvider/1.0)
SEARCH_PROVIDER_DEBUG_HTML=false
