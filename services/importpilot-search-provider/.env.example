PORT=4000
SEARCH_PROVIDER_TOKEN=change-this-search-provider-token
SEARCH_RATE_LIMIT_MAX=30
SEARCH_RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=90000

# TAJA realna web pretraga preko OpenAI Responses API-ja.
# API ključ se kreira u OpenAI Platform projektu i nikada se ne šalje u browser.
# Nisko rezonovanje, nizak web kontekst i do tri proverene ponude čuvaju
# interaktivni tok unutar zasebnog OpenAI vremenskog budžeta.
# `minimal` nije kompatibilan sa web_search alatom u ovoj integraciji.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_SEARCH_MAX_RESULTS=3
OPENAI_SEARCH_TIMEOUT_MS=45000
OPENAI_SEARCH_CONTEXT_SIZE=low

# Cenovni snapshot se upisuje uz svaki AI događaj. Kada se cenovnik promeni,
# menjaju se ove vrednosti, dok istorijski događaji zadržavaju stare cene.
OPENAI_PRICING_VERSION=openai-standard-2026-08-06
OPENAI_INPUT_PRICE_PER_MILLION_USD=0.25
OPENAI_CACHED_INPUT_PRICE_PER_MILLION_USD=0.025
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=2.00
OPENAI_WEB_SEARCH_PRICE_PER_CALL_USD=0.01

# Direktni izvori ostaju kao rezervni izvori ako OpenAI web pretraga ne vrati
# proverljive direktne stranice proizvoda.
ALIBABA_TIMEOUT_MS=4000
MADE_IN_CHINA_TIMEOUT_MS=5000
ALIBABA_USER_AGENT=Mozilla/5.0 (compatible; ImportPilotSearchProvider/1.0)
MADE_IN_CHINA_USER_AGENT=Mozilla/5.0 (compatible; ImportPilotSearchProvider/1.0)
SEARCH_PROVIDER_DEBUG_HTML=false
